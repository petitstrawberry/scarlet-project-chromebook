# USB functions are composed in this order. Keep mass_storage enabled because
# Scarlet's boot command line mounts /dev/usbblk0p2. Add `hid` later if a
# Pi-side keyboard function is needed; Ctrl+L currently comes from EC/CCD.
SCARLET_GADGET_FUNCTIONS=mass_storage,ncm
SCARLET_HID_ENABLED=0

# CDC-NCM link settings. The dedicated /30 avoids the Pi's existing 192.168.77.2
# Ethernet address. The companion scarlet-ncm service advertises the second
# address through DHCP and routes/NATs it through the Pi's Ethernet uplink.
SCARLET_NCM_IFNAME=usb0
SCARLET_NCM_PI_ADDRESS=192.168.88.1/30
SCARLET_NCM_NETWORK=192.168.88.0/30
SCARLET_NCM_UPLINK_IFNAME=eth0
# The Pi's Ethernet is a direct link to the Mac at 192.168.77.1. Leave empty
# when the upstream profile already owns the desired default route.
SCARLET_NCM_UPLINK_GATEWAY=192.168.77.1
SCARLET_NCM_UPLINK_ROUTE_METRIC=100
SCARLET_NCM_ENABLE_ROUTING=1
SCARLET_NCM_ENABLE_NAT=1
SCARLET_NCM_DHCP_START=192.168.88.2
SCARLET_NCM_DHCP_END=192.168.88.2
SCARLET_NCM_DHCP_NETMASK=255.255.255.252
SCARLET_NCM_DHCP_LEASE=1h
# Leave empty to use the Pi's current resolvers, or comma-separate IPv4 servers
# to pin explicit routeable DNS fallbacks.
SCARLET_NCM_DHCP_DNS=
SCARLET_NCM_DNS_PROXY=1
SCARLET_NCM_DEV_ADDR=02:53:43:4e:43:01
SCARLET_NCM_HOST_ADDR=02:53:43:4e:43:02
SCARLET_NCM_MAX_SEGMENT_SIZE=1514
SCARLET_NCM_QMULT=5
SCARLET_NCM_CONFIGURE_NETWORK=1
